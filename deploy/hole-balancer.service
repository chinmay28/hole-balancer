[Unit]
Description=hole-balancer: DNS load balancer for Pi-hole
Documentation=https://github.com/chinmay28/hole-balancer
After=network-online.target
Wants=network-online.target
# If Tailscale provides the only route to some upstreams, uncomment so the
# balancer's initial health sweep sees them.
# After=tailscaled.service

[Service]
Type=simple
ExecStart=/usr/local/bin/hole-balancer -config /etc/hole-balancer/config.yaml
Restart=on-failure
RestartSec=2s

# Bind port 53 without running as root. The account is created by
# deploy/install.sh and owns /etc/hole-balancer.
#
# A fixed user rather than DynamicUser=yes: the management interface writes
# configuration changes back to that directory, and a transient account gets a
# different UID on each start, so it could not own the file it has to rewrite.
User=hole-balancer
Group=hole-balancer
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# The balancer opens sockets and reads one config file. Nothing else.
NoNewPrivileges=yes
ProtectSystem=strict

# ProtectSystem=strict makes the whole filesystem read-only, which would stop
# the management interface saving anything — the "add a Pi-hole" button would
# apply the change and then fail to persist it. This is the one exception.
# Removing it silently breaks admin.allow_control; leave it in place.
ReadWritePaths=/etc/hole-balancer

ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Logs go to the journal: journalctl -u hole-balancer -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
